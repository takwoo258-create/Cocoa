# Cocoa 反向代理（Caddy，自动 HTTPS）
#
# 部署：deploy/caddy-setup.sh 会把本文件安装到 /etc/caddy/Caddyfile
# 域名：<DOMAIN>（sslip.io 泛解析 → <SERVER_IP>）
#
# 说明：
#   * Caddy 自动向 Let's Encrypt 申请证书，HTTP(80) 自动 301 到 HTTPS(443)
#   * 证书续签：certmagic 默认在剩余有效期 1/3 时续签（90 天证书 ≈ 到期前 30 天），
#     并会在启动/每日维护时检查；如需更早续签窗口可用 renewal_window_ratio（见下）
#   * 8787 端口的直连服务保持不变，老客户端与 WS 仍可直连

{
	# 证书续签窗口：0.34 ≈ 90 天证书在剩余 30 天左右续签；
	# 部分 Caddy 版本不支持该全局项，caddy-setup.sh 会先 validate，失败则自动省略
	renewal_window_ratio 0.34
}

<DOMAIN> {
	encode zstd gzip

	# 所有 API / WebSocket 请求交给 Cocoa 后端
	reverse_proxy 127.0.0.1:8787 {
		# WebSocket 由 Caddy 自动透传 Upgrade
		flush_interval -1
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}

	# 访问日志交给 journald（journalctl -u caddy），避免落地文件权限问题

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer-when-downgrade"
		-Server
	}
}

# 兜底：直接用 IP 或其它域名访问 80/443 时也转到 HTTPS 域名
:80 {
	redir https://<DOMAIN>{uri} permanent
}
