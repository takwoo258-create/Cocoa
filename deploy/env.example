# Cocoa 后端环境变量模板
# 用法：复制到 /opt/cocoa/.env（权限 600，属主 cocoa），systemd 通过 EnvironmentFile 加载。
# 该文件不得提交任何真实密钥；仓库内只保留模板。

# ── 基础 ────────────────────────────────────────────────
NODE_ENV=production
HOST=0.0.0.0
PORT=8787
PUBLIC_URL=http://<SERVER_IP>:8787
COCOA_DATA_DIR=/opt/cocoa/data
COCOA_TOKEN_TTL=2592000
COCOA_ALLOW_REGISTER=1
COCOA_LOG_LEVEL=info

# ── 加密主密钥 ──────────────────────────────────────────
# 必须 >= 32 字符。留空时服务会自动生成 data/.masterkey（首次启动）。
# 一旦生成不得更换：丢失后历史消息/记忆无法解密。
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COCOA_MASTER_KEY=

# ── 初始超级管理员（仅在库中不存在 admin 时生效）────────
COCOA_ADMIN_EMAIL=admin@cocoa.local
COCOA_ADMIN_PASSWORD=

# ── SMTP（可在管理端覆盖）────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── NapCat / OneBot11（反向 WS，端口与 NapCat 配置保持一致）────
# NapCat 上报地址：ws://<服务器IP>:8787/onebot/ws?access_token=<ONEBOT_TOKEN>
ONEBOT_TOKEN=
ONEBOT_SELF_ID=
ONEBOT_WS_PATH=/onebot/ws

# ── 默认嵌入 / 搜索服务（用户可在应用内覆盖）──────────────
COCOA_EMBEDDING_BASE_URL=
COCOA_EMBEDDING_API_KEY=
COCOA_EMBEDDING_MODEL=text-embedding-3-small
COCOA_SEARCH_BASE_URL=https://api.deepseek.com
COCOA_SEARCH_API_KEY=
